# ==========================================
# VERA ASSISTANT CONFIGURATION
# ==========================================
APP_NAME="Vera Multi-Merchant WhatsApp AI Assistant"
ENVIRONMENT="development"
DEBUG="true"

# Server Host and Port
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# Default local SQLite for instant testing or PostgreSQL async URL:
DATABASE_URL="sqlite+aiosqlite:///./vera.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://vera_user:vera_secure_password_2026@localhost:5432/vera_db"

# Redis Configuration (Optional in development, falls back to in-memory sliding window)
REDIS_URL="redis://localhost:6379/0"
USE_IN_MEMORY_CACHE="true"

# JWT Authentication
SECRET_KEY="vera-secret-key-super-secure-change-in-production-7x991z"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Meta WhatsApp Business Cloud API Integration
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="vera_whatsapp_verify_token_secure_2026"
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"
USE_MOCK_WHATSAPP="true"

# AI Provider Configuration ('gemini', 'openai', 'groq', 'ollama', 'mock')
AI_PROVIDER="mock"
AI_MODEL="gemini-1.5-flash"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Rate Limiting & Cooldown
MAX_REQUESTS_PER_MINUTE=30
RATE_LIMIT_COOLDOWN_SECONDS=60
